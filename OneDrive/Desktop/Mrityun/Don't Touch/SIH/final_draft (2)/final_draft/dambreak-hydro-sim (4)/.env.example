# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# FEATHERLESS_API_KEY: OpenAI-compatible API key for Featherless AI scenario interpretation.
# Optional - if not provided, the system uses server-side Gemini or local NLP parser.
FEATHERLESS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Set this to the Render API URL when the frontend is deployed separately on Vercel.
VITE_API_URL=""
